# Placeholders only. The app reads real environment variables (no .env loader is included).
# Qwen Cloud (DashScope international) API key; leave unset for mock mode
QWEN_API_KEY=<your-key>
# OpenRouter API key (optional alternative provider and embeddings)
OPENROUTER_API_KEY=<your-key>
# Active provider: qwen or openrouter
LLM_PROVIDER=qwen
# Model name; defaults to qwen-plus (qwen) or openai/gpt-oss-20b:free (openrouter)
LLM_MODEL=qwen-plus
# SQLite database path
MEMORY_DB_PATH=memory.db
